# Uni radio 环境变量示例
PORT=8080

# LLM: 火山引擎 Seed 2.1 Pro / OpenAI-compatible chat completions
SEED_MODEL=doubao-seed-2-1-pro-260915
# 实时电台建议关闭深度思考，避免选歌等待过久；需要时改为 enabled
SEED_THINKING=disabled
SEED_API_KEY=
SEED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 如需临时切回 DeepSeek，保留上面的 Seed 配置也可以：
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 火山引擎也支持以下等价变量名：
# VOLCENGINE_API_KEY=
# VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 如果你暂时使用其他 OpenAI-compatible 服务，也可以改用：
# UNICO_MODEL=your-model
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-relay.example/v1

# M2: NeteaseCloudMusicApi（建议本机起服务）
NCM_BASE=http://localhost:3000

# M4: Fish Audio TTS
FISH_API_KEY=
FISH_VOICE_ID=

# M5: 飞书 / OpenWeather / UPnP
LARK_APP_ID=
LARK_APP_SECRET=
OPENWEATHER_KEY=
UPNP_RENDERER_URL=
